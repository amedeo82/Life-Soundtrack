{
  "name": "@ls/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/spotify": {
      "types": "./dist/adapters/spotify/index.d.ts",
      "import": "./dist/adapters/spotify/index.js"
    },
    "./adapters/youtube": {
      "types": "./dist/adapters/youtube/index.d.ts",
      "import": "./dist/adapters/youtube/index.js"
    },
    "./adapters/apple": {
      "types": "./dist/adapters/apple/index.d.ts",
      "import": "./dist/adapters/apple/index.js"
    },
    "./adapters/listenbrainz": {
      "types": "./dist/adapters/listenbrainz/index.d.ts",
      "import": "./dist/adapters/listenbrainz/index.js"
    },
    "./adapters/lastfm": {
      "types": "./dist/adapters/lastfm/index.d.ts",
      "import": "./dist/adapters/lastfm/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude src/db/__tests__/perf.test.ts --exclude src/adapters/__tests__/perf.test.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "fflate": "^0.8.3",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@ls/config": "workspace:*",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
